{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/(analisis|area-cliente|solicitud|acceder|recuperar-contrasena|nueva-contrasena|rag-intern)(/.*)?",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/rag-intern/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/rag-intern",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(analisis|area-cliente|solicitud|acceder|recuperar-contrasena|nueva-contrasena)(/.*)?",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/servicios/resenas",
      "destination": "/servicios/google-maps-perfil-empresa",
      "permanent": true
    },
    {
      "source": "/servicios/directorios-locales",
      "destination": "/servicios/busqueda-ia",
      "permanent": true
    },
    {
      "source": "/servicios/anuncios-google-meta",
      "destination": "/servicios",
      "permanent": true
    },
    {
      "source": "/servicios/publicidad-offline",
      "destination": "/servicios",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/services",
      "destination": "/servicios",
      "permanent": true
    },
    {
      "source": "/services/ai-search-optimization",
      "destination": "/servicios/busqueda-ia",
      "permanent": true
    },
    {
      "source": "/services/google-maps-business-profile",
      "destination": "/servicios/google-maps-perfil-empresa",
      "permanent": true
    },
    {
      "source": "/services/website-google-search",
      "destination": "/servicios/web-y-google-search",
      "permanent": true
    },
    {
      "source": "/services/social-media",
      "destination": "/servicios/redes-sociales",
      "permanent": true
    },
    {
      "source": "/preise",
      "destination": "/precios",
      "permanent": true
    },
    {
      "source": "/ratgeber",
      "destination": "/guia",
      "permanent": true
    },
    {
      "source": "/ratgeber/:slug*",
      "destination": "/guia",
      "permanent": true
    },
    {
      "source": "/glossar",
      "destination": "/glosario",
      "permanent": true
    },
    {
      "source": "/glossar/:slug*",
      "destination": "/glosario",
      "permanent": true
    },
    {
      "source": "/start",
      "destination": "/empezar",
      "permanent": true
    },
    {
      "source": "/impressum",
      "destination": "/aviso-legal",
      "permanent": true
    },
    {
      "source": "/datenschutz",
      "destination": "/privacidad",
      "permanent": true
    },
    {
      "source": "/agb",
      "destination": "/condiciones",
      "permanent": true
    },
    {
      "source": "/check",
      "destination": "/analisis",
      "permanent": true
    },
    {
      "source": "/kabinett",
      "destination": "/area-cliente",
      "permanent": true
    },
    {
      "source": "/login",
      "destination": "/acceder",
      "permanent": true
    },
    {
      "source": "/anfrage",
      "destination": "/solicitud",
      "permanent": true
    },
    {
      "source": "/passwort-vergessen",
      "destination": "/recuperar-contrasena",
      "permanent": true
    }
  ]
}